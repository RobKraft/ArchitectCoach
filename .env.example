# Postgres connection used by Prisma. Matches docker-compose.yml's default credentials.
# Port 5433, not 5432 — see docker-compose.yml's comment.
DATABASE_URL="postgresql://architectcoach:architectcoach@localhost:5433/architectcoach"

# Which LLM provider powers the interview/coaching engine: "anthropic" or "openai".
LLM_PROVIDER="anthropic"

# Set the key matching LLM_PROVIDER above. Only one is required.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Model overrides (optional — sensible defaults are used if unset).
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_MODEL="gpt-4.1"

# Model used by the pre-call moderation gate (src/lib/llm/moderation.ts) — deliberately
# smaller/cheaper than the coaching model above. Optional overrides.
ANTHROPIC_GATE_MODEL="claude-haiku-4-5"
OPENAI_GATE_MODEL="gpt-4o-mini"
