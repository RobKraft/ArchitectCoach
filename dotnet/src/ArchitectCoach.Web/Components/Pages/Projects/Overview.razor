@page "/projects/{Id:guid}"
@inherits ProjectPageBase

@if (Project is not null)
{
    <PageTitle>@Project.ProjectType · ArchitectCoach</PageTitle>
    <div class="project-shell">
        <ProjectNav Project="Project" Active="" />
        <div>
            <h1>Overview</h1>
            @{
                var answered = Math.Min(Project.StepIndex, Steps.Count);
                var done = answered >= Steps.Count;
            }
            <section class="card-panel mb-3" aria-labelledby="progress-heading">
                <h2 id="progress-heading" class="h5">Progress</h2>
                <p>@answered of @Steps.Count questions answered.</p>
                <progress max="@Steps.Count" value="@answered" aria-label="Interview progress">@answered of @Steps.Count</progress>
                <p class="mt-3 mb-0">
                    <a class="@(done ? "btn btn-outline-secondary" : "btn btn-primary")" href="@ProjectUrl("interview")">@(done ? "Review the interview" : answered == 0 ? "Start the interview" : "Continue the interview")</a>
                </p>
            </section>
            @if (done)
            {
                <section class="card-panel mb-3" aria-labelledby="kit-heading">
                    <h2 id="kit-heading" class="h5">Your Spec Kit</h2>
                    <SpecKitDownload Project="Project" />
                </section>
            }
            <section class="card-panel" aria-labelledby="decisions-heading">
                <h2 id="decisions-heading" class="h5">Decisions so far</h2>
                @if (Project.Decisions.Count == 0)
                {
                    <p class="muted mb-0">None yet. Architecture and technology choices are recorded here as you answer.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var d in Project.Decisions)
                        {
                            <li><a href="@ProjectUrl($"decisions/{d.Number}")">@d.Title</a>: @DecisionLabel(d.Decision)</li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    /// <summary>Decision text is stored as 'Label (for: "question")'; show just the label here.</summary>
    internal static string DecisionLabel(string decision)
    {
        var i = decision.IndexOf(" (for: \"", StringComparison.Ordinal);
        return i > 0 ? decision[..i] : decision;
    }
}
