@inject NavigationManager NavigationManager

<nav class="container site-nav" aria-label="Main">
    <a class="site-brand" href="">ArchitectCoach</a>
    <ul class="site-links">
        <AuthorizeView>
            <Authorized>
                <li><NavLink href="projects">My projects</NavLink></li>
                <li><NavLink href="Account/Manage">Account</NavLink></li>
                <li>
                    <form action="Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit" class="btn btn-link site-link-button">Sign out</button>
                    </form>
                </li>
            </Authorized>
            <NotAuthorized>
                <li><NavLink href="Account/Login">Sign in</NavLink></li>
                <li><NavLink href="Account/Register">Create account</NavLink></li>
            </NotAuthorized>
        </AuthorizeView>
    </ul>
</nav>
